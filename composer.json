{
    "name": "phattarachai/claude-tasks-laravel",
    "description": "Headless Claude task runner for Laravel — declare a Task class (prompt + JSON schema + context), run it through the Claude Code CLI, get schema-validated JSON back. The model returns data; the app writes the database.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "claude",
        "claude-code",
        "ai",
        "structured-output",
        "task-runner"
    ],
    "authors": [
        {
            "name": "Phattarachai Chaimongkol",
            "email": "pc@phattarachai.dev"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/json-schema": "^12.62 || ^13.15",
        "illuminate/pipeline": "^12.0 || ^13.0",
        "illuminate/process": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "laravel/serializable-closure": "^1.3 || ^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.8|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phattarachai/task-runs-laravel": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../task-runs-laravel",
            "options": {
                "symlink": true
            }
        }
    ],
    "suggest": {
        "phattarachai/task-runs-laravel": "Records every Claude run as a task_runs row (cost, turns, model, session id) when installed."
    },
    "autoload": {
        "psr-4": {
            "Phattarachai\\ClaudeTasksLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phattarachai\\ClaudeTasksLaravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Phattarachai\\ClaudeTasksLaravel\\ClaudeTasksServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
